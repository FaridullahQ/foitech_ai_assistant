<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odoo_ai_chat_history_list" model="ir.ui.view">
        <field name="name">odoo.ai.chat.history.list</field>
        <field name="model">odoo.ai.chat.history</field>
        <field name="arch" type="xml">
            <tree string="AI Chat History" delete="0" create="0">
                <field name="create_date" string="Date"/>
                <field name="user_id" string="User"/>
                <field name="query_type" string="Type"/>
                <field name="prompt" string="Question"/>
                <field name="answer" string="Answer"/>
            </tree>
        </field>
    </record>

    <record id="view_odoo_ai_chat_history_form" model="ir.ui.view">
        <field name="name">odoo.ai.chat.history.form</field>
        <field name="model">odoo.ai.chat.history</field>
        <field name="arch" type="xml">
            <form string="Chat History" create="false" edit="false">
                <sheet>
                    <group>
                        <field name="create_date" string="Date"/>
                        <field name="user_id" string="User"/>
                        <field name="query_type" string="Type"/>
                    </group>
                    <group string="Conversation">
                        <field name="prompt" string="Question" nolabel="1" widget="text"/>
                        <field name="answer" string="Answer" nolabel="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_odoo_ai_chat_history" model="ir.actions.act_window">
        <field name="name">AI Chat History</field>
        <field name="res_model">odoo.ai.chat.history</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
    </record>
</odoo>
