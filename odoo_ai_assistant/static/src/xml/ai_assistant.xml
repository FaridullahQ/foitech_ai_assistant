<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="odoo_ai_assistant.AIAssistant" owl="1">

    <!-- ── Floating Bubble ─────────────────────────────────────────── -->
    <div class="ai-assistant-root">

        <!-- Bubble Button -->
        <button class="ai-fab" t-on-click="toggleOpen" t-att-class="state.open ? 'ai-fab ai-fab--active' : 'ai-fab'">
            <span t-if="!state.open" class="ai-fab-icon">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2C6.48 2 2 6.48 2 12C2 13.85 2.5 15.58 3.37 17.07L2 22L6.93 20.63C8.42 21.5 10.15 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2Z" fill="currentColor" opacity="0.2"/>
                    <path d="M8 12H8.01M12 12H12.01M16 12H16.01" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                </svg>
            </span>
            <span t-if="state.open" class="ai-fab-icon ai-fab-icon--close">✕</span>
            <span class="ai-fab-pulse"/>
        </button>

        <!-- ── Chat Panel ─────────────────────────────────────────── -->
        <div t-if="state.open" t-att-class="state.minimized ? 'ai-panel ai-panel--minimized' : 'ai-panel'">

            <!-- Header -->
            <div class="ai-panel-header">
                <div class="ai-header-left">
                    <div class="ai-avatar">
                        <svg viewBox="0 0 32 32" fill="none">
                            <circle cx="16" cy="16" r="16" fill="url(#grad1)"/>
                            <defs>
                                <linearGradient id="grad1" x1="0" y1="0" x2="32" y2="32">
                                    <stop offset="0%" stop-color="#6366f1"/>
                                    <stop offset="100%" stop-color="#22d3ee"/>
                                </linearGradient>
                            </defs>
                            <path d="M10 16C10 13.8 11.8 12 14 12H18C20.2 12 22 13.8 22 16C22 18.2 20.2 20 18 20H16L13 23V20H14C11.8 20 10 18.2 10 16Z" fill="white" opacity="0.9"/>
                        </svg>
                    </div>
                    <div class="ai-header-info">
                        <span class="ai-header-title">Odoo AI Assistant</span>
                        <span t-att-class="getProviderBadgeClass()" t-esc="state.providerLabel"/>
                    </div>
                </div>
                <div class="ai-header-actions">
                    <button class="ai-icon-btn" title="Clear chat" t-on-click="clearChat">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/>
                        </svg>
                    </button>
                    <button class="ai-icon-btn" title="Minimize" t-on-click="minimize">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="5" y1="12" x2="19" y2="12"/>
                        </svg>
                    </button>
                    <button class="ai-icon-btn" title="Close" t-on-click="toggleOpen">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Minimized Bar -->
            <div t-if="state.minimized" class="ai-minimized-bar" t-on-click="restore">
                <span>Click to restore AI Assistant</span>
            </div>

            <!-- Body -->
            <div t-if="!state.minimized" class="ai-panel-body">

                <!-- Messages -->
                <div class="ai-messages" t-ref="messagesContainer">

                    <!-- Welcome message -->
                    <t t-if="state.messages.length === 0">
                        <div class="ai-welcome">
                            <div class="ai-welcome-icon">🤖</div>
                            <div class="ai-welcome-title">Hello! I'm your Odoo AI Assistant</div>
                            <div class="ai-welcome-sub">Ask me anything about your data — any module, any model.</div>
                        </div>
                    </t>

                    <!-- Suggestion Pills -->
                    <t t-if="state.showSuggestions and state.messages.length === 0">
                        <div class="ai-suggestions">
                            <div class="ai-suggestions-label">Try asking:</div>
                            <div class="ai-suggestions-grid">
                                <t t-foreach="suggestions" t-as="s" t-key="s">
                                    <button class="ai-suggestion-pill" t-on-click="() => selectSuggestion(s)">
                                        <t t-esc="s"/>
                                    </button>
                                </t>
                            </div>
                        </div>
                    </t>

                    <!-- Message Bubbles -->
                    <t t-foreach="state.messages" t-as="msg" t-key="msg_index">

                        <!-- User message -->
                        <div t-if="msg.role === 'user'" class="ai-msg ai-msg--user">
                            <div class="ai-msg-bubble ai-msg-bubble--user">
                                <t t-esc="msg.text"/>
                            </div>
                        </div>

                        <!-- Assistant message -->
                        <div t-if="msg.role === 'assistant'" class="ai-msg ai-msg--assistant">
                            <div class="ai-msg-avatar">🤖</div>
                            <div class="ai-msg-content">
                                <div t-att-class="msg.success === false ? 'ai-msg-bubble ai-msg-bubble--error' : 'ai-msg-bubble ai-msg-bubble--assistant'"
                                     t-out="formatText(msg.text)"/>

                                <!-- Chart -->
                                <div t-if="msg.chart" class="ai-chart-wrapper">
                                    <canvas t-att-id="'ai-chart-' + msg_index" height="220"/>
                                </div>

                                <!-- Export Button -->
                                <div t-if="msg.export and msg.export.length" class="ai-msg-actions">
                                    <button class="ai-export-btn" t-on-click="() => exportCSV(msg_index)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                                            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                                            <polyline points="7 10 12 15 17 10"/>
                                            <line x1="12" y1="15" x2="12" y2="3"/>
                                        </svg>
                                        Export CSV (<t t-esc="msg.export.length"/> rows)
                                    </button>
                                </div>
                            </div>
                        </div>

                    </t>

                    <!-- Typing indicator -->
                    <div t-if="state.loading" class="ai-msg ai-msg--assistant">
                        <div class="ai-msg-avatar">🤖</div>
                        <div class="ai-typing">
                            <span/><span/><span/>
                        </div>
                    </div>

                </div>

                <!-- Input Area -->
                <div class="ai-input-area">
                    <textarea
                        class="ai-input"
                        t-ref="promptInput"
                        t-model="state.prompt"
                        t-on-keydown="handleKeydown"
                        placeholder="Ask anything about your Odoo data..."
                        rows="2"
                        t-att-disabled="state.loading"
                    />
                    <button
                        class="ai-send-btn"
                        t-on-click="sendMessage"
                        t-att-disabled="state.loading or !state.prompt.trim()"
                    >
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M22 2L11 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M22 2L15 22L11 13L2 9L22 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                </div>

                <div class="ai-footer-hint">
                    Powered by <strong t-esc="state.providerLabel"/> · Read-only queries · <a href="/web#action=base_setup.action_general_configuration" target="_self">Settings</a>
                </div>

            </div>
        </div>

    </div>
</t>

</templates>