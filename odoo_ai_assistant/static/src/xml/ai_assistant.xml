<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="odoo_ai_assistant.AIAssistant" owl="1">

    <div class="ai-assistant-root">

        <!-- ── Floating launcher ───────────────────────────────────── -->
        <button class="ai-fab" t-on-click="toggleOpen"
                t-att-class="state.open ? 'ai-fab ai-fab--active' : 'ai-fab'"
                title="Odoo AI Assistant">
            <span class="ai-fab-ring"/>
            <span t-if="!state.open" class="ai-fab-icon">
                <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2l2.2 6.3L20.5 10.5l-6.3 2.2L12 19l-2.2-6.3L3.5 10.5l6.3-2.2L12 2z"/>
                    <path d="M19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9L19 15z" opacity="0.7"/>
                </svg>
            </span>
            <span t-if="state.open" class="ai-fab-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
                    <line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/>
                </svg>
            </span>
            <span class="ai-fab-dot"/>
        </button>

        <!-- ── Chat panel ──────────────────────────────────────────── -->
        <div t-if="state.open" t-att-class="state.minimized ? 'ai-panel ai-panel--minimized' : 'ai-panel'">

            <!-- Header -->
            <div class="ai-panel-header">
                <div class="ai-header-left">
                    <div class="ai-avatar">
                        <svg viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 2l2.2 6.3L20.5 10.5l-6.3 2.2L12 19l-2.2-6.3L3.5 10.5l6.3-2.2L12 2z"/>
                        </svg>
                    </div>
                    <div class="ai-header-info">
                        <span class="ai-header-title">Odoo AI Assistant</span>
                        <span class="ai-status" t-att-title="'AI engine: ' + state.providerLabel">
                            <i class="ai-status-dot"/> Online
                        </span>
                    </div>
                </div>
                <div class="ai-header-actions">
                    <button class="ai-icon-btn" title="About" t-on-click="toggleAbout">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <circle cx="12" cy="12" r="9"/><line x1="12" y1="11" x2="12" y2="16.5"/><circle cx="12" cy="7.8" r="0.6" fill="currentColor"/>
                        </svg>
                    </button>
                    <button class="ai-icon-btn" title="Clear chat" t-on-click="clearChat">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/>
                        </svg>
                    </button>
                    <button class="ai-icon-btn" title="Minimize" t-on-click="minimize">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <line x1="5" y1="12" x2="19" y2="12"/>
                        </svg>
                    </button>
                    <button class="ai-icon-btn" title="Close" t-on-click="toggleOpen">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Minimized bar -->
            <div t-if="state.minimized" class="ai-minimized-bar" t-on-click="restore">
                <span>Click to restore AI Assistant</span>
            </div>

            <!-- Body -->
            <div t-if="!state.minimized" class="ai-panel-body">

                <div class="ai-messages" t-ref="messagesContainer">

                    <!-- Welcome -->
                    <t t-if="state.messages.length === 0">
                        <div class="ai-welcome">
                            <div class="ai-orb">
                                <svg viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 2l2.2 6.3L20.5 10.5l-6.3 2.2L12 19l-2.2-6.3L3.5 10.5l6.3-2.2L12 2z"/>
                                </svg>
                            </div>
                            <div class="ai-welcome-title">Hello, I'm your Odoo AI Assistant</div>
                            <div class="ai-welcome-sub">Ask me anything about your data — any module, any model.</div>
                        </div>
                    </t>

                    <!-- Suggestions -->
                    <t t-if="state.showSuggestions and state.messages.length === 0">
                        <div class="ai-suggestions">
                            <div class="ai-suggestions-label">Try asking</div>
                            <div class="ai-suggestions-grid">
                                <t t-foreach="suggestions" t-as="s" t-key="s">
                                    <button class="ai-suggestion-pill" t-on-click="() => selectSuggestion(s)">
                                        <t t-esc="s"/>
                                    </button>
                                </t>
                            </div>
                        </div>
                    </t>

                    <!-- Messages -->
                    <t t-foreach="state.messages" t-as="msg" t-key="msg_index">

                        <div t-if="msg.role === 'user'" class="ai-msg ai-msg--user">
                            <div class="ai-msg-bubble ai-msg-bubble--user">
                                <t t-esc="msg.text"/>
                            </div>
                        </div>

                        <div t-if="msg.role === 'assistant'" class="ai-msg ai-msg--assistant">
                            <div class="ai-msg-avatar">
                                <svg viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 2l2.2 6.3L20.5 10.5l-6.3 2.2L12 19l-2.2-6.3L3.5 10.5l6.3-2.2L12 2z"/>
                                </svg>
                            </div>
                            <div class="ai-msg-content">
                                <div t-att-class="msg.success === false ? 'ai-msg-bubble ai-msg-bubble--error' : 'ai-msg-bubble ai-msg-bubble--assistant'"
                                     t-out="formatText(msg.text)"/>

                                <div t-if="msg.chart" class="ai-chart-wrapper">
                                    <canvas t-att-id="'ai-chart-' + msg_index" height="220"/>
                                </div>

                                <div t-if="msg.export and msg.export.length" class="ai-msg-actions">
                                    <button class="ai-export-btn" t-on-click="() => exportCSV(msg_index)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                                            <polyline points="7 10 12 15 17 10"/>
                                            <line x1="12" y1="15" x2="12" y2="3"/>
                                        </svg>
                                        Export CSV (<t t-esc="msg.export.length"/> rows)
                                    </button>
                                </div>
                            </div>
                        </div>

                    </t>

                    <!-- Typing -->
                    <div t-if="state.loading" class="ai-msg ai-msg--assistant">
                        <div class="ai-msg-avatar">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2l2.2 6.3L20.5 10.5l-6.3 2.2L12 19l-2.2-6.3L3.5 10.5l6.3-2.2L12 2z"/>
                            </svg>
                        </div>
                        <div class="ai-typing"><span/><span/><span/></div>
                    </div>

                </div>

                <!-- Input -->
                <div class="ai-input-area">
                    <textarea
                        class="ai-input"
                        t-ref="promptInput"
                        t-model="state.prompt"
                        t-on-keydown="handleKeydown"
                        placeholder="Ask anything about your Odoo data..."
                        rows="2"
                        t-att-disabled="state.loading"
                    />
                    <button
                        class="ai-send-btn"
                        t-on-click="sendMessage"
                        t-att-disabled="state.loading or !state.prompt.trim()"
                        title="Send"
                    >
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M22 2L11 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M22 2L15 22L11 13L2 9L22 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                </div>

                <!-- Footer -->
                <div class="ai-footer-hint">
                    <span class="ai-footer-brand" t-att-title="'Developed by ' + about.developer">
                        Powered by <strong>FOITECH-Digital Solutions</strong>
                    </span>
                    <span class="ai-footer-sep">·</span>
                    <span>Read-only</span>
                    <span class="ai-footer-sep">·</span>
                    <a href="/web#action=base_setup.action_general_configuration" target="_self">Settings</a>
                </div>

            </div>

            <!-- About overlay -->
            <div t-if="state.showAbout and !state.minimized" class="ai-about">
                <div class="ai-about-card">
                    <div class="ai-orb ai-orb--sm">
                        <svg viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 2l2.2 6.3L20.5 10.5l-6.3 2.2L12 19l-2.2-6.3L3.5 10.5l6.3-2.2L12 2z"/>
                        </svg>
                    </div>
                    <div class="ai-about-title" t-esc="about.name"/>
                    <div class="ai-about-version">Version <t t-esc="about.version"/></div>
                    <div class="ai-about-divider"/>
                    <div class="ai-about-label">Developed by</div>
                    <div class="ai-about-dev" t-esc="about.developer"/>
                    <a class="ai-about-mail" t-att-href="'mailto:' + about.email" t-esc="about.email"/>
                    <div class="ai-about-contacts">
                        <a class="ai-about-chip" t-att-href="'tel:' + about.phoneRaw" title="Call">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2"/></svg>
                            <t t-esc="about.phone"/>
                        </a>
                        <a class="ai-about-chip ai-about-chip--wa" t-att-href="about.whatsapp" target="_blank" rel="noopener" title="Chat on WhatsApp">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"/><path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"/></svg>
                            WhatsApp
                        </a>
                    </div>
                    <div class="ai-about-company" t-esc="about.company"/>
                    <button class="ai-about-close" t-on-click="toggleAbout">Close</button>
                </div>
            </div>

        </div>

    </div>
</t>

</templates>
